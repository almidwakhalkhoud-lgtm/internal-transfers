{
  "name": "buzz-internal-transfers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:copy": "tsx --env-file=.env scripts/copy-database.ts",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/test-runner.mjs",
    "db:push": "prisma db push",
    "db:local": "node scripts/local-db.mjs",
    "admin": "tsx --env-file=.env scripts/admin.ts",
    "setup": "node scripts/enable-setup.mjs",
    "catalog:initial": "tsx --env-file=.env scripts/import-sources.ts",
    "db:deploy": "prisma migrate deploy",
    "qbm:inspect": "tsx scripts/qbm-inspect.ts",
    "test:notifications": "node scripts/test-notifications.mjs",
    "db:migrate": "prisma migrate deploy",
    "notifications:keys": "node scripts/notification-keys.mjs",
    "notifications:worker": "tsx --env-file=.env scripts/notification-worker.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sparticuz/chromium": "153.0.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.8.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "playwright": "^1.58.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.90.0",
    "web-push": "^3.6.7",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.18"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
